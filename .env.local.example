NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Acesso vitalício (dono/desenvolvedor) — bypassa a tabela `assinaturas`,
# lista de e-mails separada por vírgula. Ver lib/hooks/use-plan.ts.
NEXT_PUBLIC_LIFETIME_EMAILS=seu-email@exemplo.com

# Chave de service role do Supabase — usada só em rotas server-to-server sem
# sessão de usuário (webhooks da Asaas/Fiscal Contora, API de parceiros B2B em
# app/api/parceiro/**). NUNCA expor com prefixo NEXT_PUBLIC_. Pegar em
# Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Fiscal Contora (NF-e, NFC-e e NFS-e) — substituiu a Focus NFe em 2026-09.
# A Contora escopa a API key por ambiente (uma chave de produção não opera em
# homologação, mesmo pra empresas com allows_homologation) — por isso são
# duas chaves, igual à Focus NFe antes. Pegar em
# https://fiscal.contora.com.br > Configurações > API.
CONTORA_API_TOKEN_PRODUCAO=seu-token-producao-aqui
CONTORA_API_TOKEN_HOMOLOGACAO=seu-token-homologacao-aqui
# Segredo do webhook (gerado ao registrar o endpoint via criarWebhookEndpoint) —
# usado para validar a assinatura HMAC em app/api/nfse/webhook.
CONTORA_WEBHOOK_SECRET=seu-webhook-secret-aqui
