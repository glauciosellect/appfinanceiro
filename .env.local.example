NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Acesso vitalício (dono/desenvolvedor) — bypassa a tabela `assinaturas`,
# lista de e-mails separada por vírgula. Ver lib/hooks/use-plan.ts.
NEXT_PUBLIC_LIFETIME_EMAILS=seu-email@exemplo.com

# Chave de service role do Supabase — usada só em rotas server-to-server sem
# sessão de usuário (webhooks da Asaas/Focus NFe, API de parceiros B2B em
# app/api/parceiro/**). NUNCA expor com prefixo NEXT_PUBLIC_. Pegar em
# Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
